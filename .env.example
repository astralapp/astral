APP_NAME=Astral
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://astral.test

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# For the Docker stack, host/driver values (DB_HOST, REDIS_HOST,
# CACHE_DRIVER, SESSION_DRIVER, QUEUE_CONNECTION, APP_URL) are set
# automatically by Compose — only the credentials below need to match.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=astral
DB_USERNAME=astral
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@astralapp.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CLIENT_CALLBACK_URL=https://astral.test/auth/github/callback
GITHUB_TEST_ACCESS_TOKEN=
GITHUB_SPONSOREE_LOGIN=syropian

# Sponsor-gating (public multi-user instances only — leave off for personal/self-hosted)
CHECK_FOR_SPONSORSHIP=false

# Legacy migration (hosted instance only — leave off for local/self-hosted)
CHECK_FOR_MIGRATION=false
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Docker host ports (optional — these are the defaults Compose uses)
# APP_PORT=8080
# VITE_PORT=5173
# FORWARD_DB_PORT=3306
# FORWARD_REDIS_PORT=6379
